<Window x:Class="ValSpot.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ValSpot" Width="480" Height="760" MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#0F1923"
        Icon="/Assets/valspot.png" ResizeMode="CanResize">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,18,20,16">

      <!-- header -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Source="/Assets/valspot.png" Width="44" Height="44" Margin="0,0,12,0"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="ValSpot" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="VersionText" Text="3.0.0" Style="{StaticResource Hint}" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Sub}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Waiting for VALORANT" Margin="7,0,0,0" Style="{StaticResource Hint}"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- update banner -->
      <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="#2A1F12" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
        <DockPanel>
          <Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Download" Style="{StaticResource Primary}" Click="UpdateButton_Click"/>
          <TextBlock x:Name="UpdateText" Text="A new version is available." VerticalAlignment="Center" Foreground="{StaticResource Amber}"/>
        </DockPanel>
      </Border>

      <!-- music -->
      <TextBlock Text="MUSIC" Style="{StaticResource Heading}"/>
      <Border Style="{StaticResource CardBox}">
        <StackPanel>
          <CheckBox x:Name="PlayOnDeath" Style="{StaticResource Switch}" Content="Play while you're dead"/>
          <CheckBox x:Name="PlayInBuy" Style="{StaticResource Switch}" Content="Play during the buy phase"/>
          <CheckBox x:Name="PlayInLobby" Style="{StaticResource Switch}" Content="Play when you're back in the lobby"/>
          <DockPanel Margin="0,10,0,2">
            <TextBlock x:Name="LeadText" DockPanel.Dock="Right" Text="3.0 s" Style="{StaticResource Hint}"/>
            <TextBlock Text="Stop before the round starts"/>
          </DockPanel>
          <Slider x:Name="LeadSlider" Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="1"/>
          <CheckBox x:Name="Fade" Style="{StaticResource Switch}" Content="Fade in and out" Margin="0,12,0,4"/>
          <DockPanel x:Name="FadeRow" Margin="0,2,0,2">
            <TextBlock x:Name="FadeText" DockPanel.Dock="Right" Text="0.8 s" Style="{StaticResource Hint}"/>
            <TextBlock Text="Fade length" Style="{StaticResource Hint}"/>
          </DockPanel>
          <Slider x:Name="FadeSlider" Minimum="0.2" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" SmallChange="0.1" LargeChange="0.5"/>

          <TextBlock Text="Music app" Margin="0,14,0,6"/>
          <WrapPanel>
            <RadioButton x:Name="AppSpotify" GroupName="app" Style="{StaticResource Segment}" Content="Spotify"/>
            <RadioButton x:Name="AppAny" GroupName="app" Style="{StaticResource Segment}" Content="Whatever's playing"/>
            <RadioButton x:Name="AppOther" GroupName="app" Style="{StaticResource Segment}" Content="Other app"/>
          </WrapPanel>
          <TextBox x:Name="AppName" Margin="0,8,0,0" ToolTip="Part of the app's name, e.g. AppleMusic, Tidal, Chrome"/>
          <TextBlock x:Name="AppStatus" Text="" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <!-- death detection -->
      <TextBlock Text="DEATH DETECTION" Style="{StaticResource Heading}"/>
      <Border Style="{StaticResource CardBox}">
        <StackPanel>
          <TextBlock x:Name="CalText" Text="Learns your screen automatically the first time you die and spectate."/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,10"
                     Text="It watches for the &quot;SWITCH PLAYER&quot; line under your teammate's name. Other game language, or it never notices you died? Teach it once:"/>
          <WrapPanel>
            <Button x:Name="LearnButton" Content="Learn my death screen…" Style="{StaticResource Primary}" Margin="0,0,8,0" Click="LearnButton_Click"/>
            <Button x:Name="ResetCalButton" Content="Forget what it learned" Click="ResetCalButton_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- app -->
      <TextBlock Text="APP" Style="{StaticResource Heading}"/>
      <Border Style="{StaticResource CardBox}">
        <StackPanel>
          <CheckBox x:Name="StartWithWindows" Style="{StaticResource Switch}">
            <StackPanel>
              <TextBlock Text="Start with Windows"/>
              <TextBlock Text="Waits quietly in the tray until VALORANT opens" Style="{StaticResource Hint}"/>
            </StackPanel>
          </CheckBox>
          <CheckBox x:Name="CheckUpdates" Style="{StaticResource Switch}" Content="Check GitHub for updates"/>
          <CheckBox x:Name="PauseAll" Style="{StaticResource Switch}">
            <StackPanel>
              <TextBlock Text="Pause ValSpot"/>
              <TextBlock Text="Leaves your music alone until you turn this off" Style="{StaticResource Hint}"/>
            </StackPanel>
          </CheckBox>
          <WrapPanel Margin="0,10,0,0">
            <Button Content="Open log folder" Margin="0,0,8,0" Click="OpenFolder_Click"/>
            <Button x:Name="CheckNow" Content="Check for updates" Click="CheckNow_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="10,2,10,4"
                 Text="Never touches the game: it reads VALORANT's own log file and takes a tiny screenshot of the bottom-left while a round is live and VALORANT is the window you're in."/>
      <Button Content="github.com/kirmitboi1123/ValSpot" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Click="Repo_Click"/>
    </StackPanel>
  </ScrollViewer>
</Window>
